@* view to add the movies *@

@model Mission06_Adams.Models.Movie

<h1>Add a movie to the collection!!!!!!!</h1>

<form method="post">
    <label asp-for="Title">Title:</label>
    <input asp-for="Title" required />
    <br />

    <label asp-for="Category">Category:</label>
    <input asp-for="Category" required />
    <br />

    <label asp-for="Year">Year:</label>
    <input asp-for="Year" type="number" required />
    <br />

    <label asp-for="Director">Director:</label>
    <input asp-for="Director" required />
    <br />

    <label asp-for="Rating">Rating</label>
    <select asp-for="Rating">
        <option value="" selected disabled>Select a rating</option>
        <option>G</option>
        <option>PG</option>
        <option>PG-13</option>
        <option>R</option>
    </select>
    <br />

    <label asp-for="Edited">Edited?</label>
    <select asp-for="Edited">
        <option value="" selected disabled>Select a rating</option>
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
    <br />

    <label asp-for="LentTo">Lent to:</label>
    <input asp-for="LentTo" />
    <br />

    <label asp-for="Notes" >Notes:</label>
    <input asp-for="Notes"  type="text" maxlength="25" />
    <br />

    <button type="submit">Add movie</button>
</form>