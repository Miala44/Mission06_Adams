@* view to add the movies *@

@* Title, year, edited, and plex ARE REQUIRED for entry *@
@* Min year 0f 1888 *@

@model Mission06_Adams.Models.Movie

<h1>Add a movie to the collection!!!!!!!</h1>

<form method="post">
    <input type="hidden" , asp-for="MovieID" />


    <label asp-for="Title">Title:</label>
    <input asp-for="Title" required />
    <br />

    <select asp-for="CategoryId">
        <option value="">Select Category</option>
        @foreach (Category c in ViewBag.Categories)
        {
            <option value="@c.CategoryId"> @c.CategoryName</option>
        }
    </select>
    <br />


    <label asp-for="Year">Year:</label>
    <input asp-for="Year" type="number" min="1888" required />
    <br />

    <label asp-for="Director">Director:</label>
    <input asp-for="Director" />
    <br />

    <label asp-for="Rating">Rating</label>
    <select asp-for="Rating">
        <option value="" selected disabled>Select a rating</option>
        <option>G</option>
        <option>PG</option>
        <option>PG-13</option>
        <option>R</option>
    </select>
    <br />

    <label asp-for="Edited">Edited?</label>
    <select asp-for="Edited" required>
        <option value="" selected disabled>Select a rating</option>
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
    <br />

    <label asp-for="CopiedToPlex">Copied to Plex?</label>
    <select asp-for="CopiedToPlex" required>
        <option value="" selected disabled>Select</option>
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
    <br />

    <label asp-for="LentTo">Lent to:</label>
    <input asp-for="LentTo" />
    <br />

    <label asp-for="Notes">Notes:</label>
    <input asp-for="Notes" type="text" maxlength="25" />
    <br />

    <button type="submit">Add movie</button>
</form>